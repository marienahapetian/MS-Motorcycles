{% extends 'base.html.twig' %}
{% block header %}
    <section class="hero">
        {% include 'partials/_header.html.twig' %}
        <div class="hero-content h-screen relative overflow-hidden" data-controller="slider">
            {% for slide in sliderImgs %}
                <div class="slide absolute inset-0 transition-opacity duration-700 h-full">
                    <img src="{{ asset(slide.img) }}" alt="Bike" />
                    <div class="hero-text">
                        <h1>
                            {{ slide.text }}
                        </h1>
                    </div>
                </div>
            {% endfor %}
            <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2 z-10">
                {% for slide in sliderImgs %}
                    <button data-action="click->slider#goToSlide" data-slide-index="{{ loop.index0 }}" class="w-3 h-3 rounded-full bg-white/50 hover:bg-white transition cursor-pointer"></button>
                {% endfor %}
            </div>
        </div>
    </section>
{% endblock %}
{% block content %}
    <section id="about" class="dotted-bg text-center">
        <img src="{{ asset('images/logo-removebg.png') }}" alt="M&S Logo" />
        <img src="{{ asset('images/moto.png') }}" class="absolute" alt="M&S Moto Background" />
        <h3 class="accentcolor">
            À propos de MSMotorcycles
        </h3>
        <h2>
            Real Bikers
            <br/>
            Real Life
        </h2>
        <p>
            The Bikers Club is a community in Mumbai and Pune.
            <br/>
            Incepted in 2010,  with a vision of uniting motorcycling enthusiasts,
            <br/>
            today the BC have  positively impacted more than a thousand riders many – of these
            <br/>
            try not  missing even a single ride!
            <br/>
            The BC do not promote any single brand of  motorcycles, no matter what machine you ride,
            <br/>
            you are welcomed!
        </p>
    </section>
    <section id="services" class="dark-bg text-center px-3 py-10 md:p-15">
        <img src="{{ asset('images/customer-support.png') }}" class="h-15 md:h-22.5" alt="M&S Moto Services" />
        <h3 class="mt-2.5">
            Ce que nous proposons
        </h3>
        <h2 class="mb-11">
            Nos Services
        </h2>
        <div class="max-w-6xl mx-auto px-4">
            <div class="grid md:grid-cols-3 gap-5 md:gap-13.75">
                {% for service in services %}
                    <div class="card text-center px-6.25 h-80 md:h-90 relative">
                        <div class="icon-cont size-fit mx-auto mb-6 px-10.75 py-5.75  flex items-center justify-center">
                            <img src="{{ asset('images/' ~ service.icon ~ '.png') }}" class="h-10 md:h-16" />
                        </div>
                        <h3 class="text-2xl font-semibold mb-4 ">
                            {{ service.title }}
                        </h3>
                        <p class="text-left">
                            {{ service.text }}
                        </p>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
    <section id="articles" class="dotted-bg text-center px-3 py-10 md:p-15">
        <img src="{{ asset('images/motorcycle.png') }}" class="h-22.5" alt="M&S Moto Bikes" />
        <h3 class="mt-2.5">
            Ce que nous proposons
        </h3>
        <h2 class="mb-11">
            Nos Motos
        </h2>
        <div class="max-w-8xl mx-auto px-4">
            <div class="grid md:grid-cols-3 gap-7.5">
                {% for bike in bikes %}
                    <div class="card relative pb-3.5">
                        <a href="{{ path('product_show', {slug: bike.slug, id: bike.id}) }}">
                            <div class="relative icon-cont mb-6.25 h-40 md:h-70 overflow-hidden group product-image">
                                {% set firstGalleryImage = bike.galleryImages|first %}
                                {% set hoverImage = firstGalleryImage ? firstGalleryImage.image : null %}
                                <img src="{{ bike.mainImage ? bike.mainImage.image : '/images/noimage.jpg' }}" alt="{{ bike.name }}" class="
                                    absolute inset-0 w-full h-full object-cover object-center
                                    {% if hoverImage %}
                                    transition-opacity duration-300 group-hover:opacity-0
                                    {% endif %}
                                " />
                                {% if hoverImage %}
                                    <img src="{{ hoverImage }}" alt="{{ bike.name }}" class="
                                    absolute inset-0 w-full h-full object-cover object-center
                                    opacity-0 transition-opacity duration-300
                                    group-hover:opacity-100
                                " />
                                {% endif %}
                            </div>
                            <h3 class="text-lg md:text-2xl font-semibold mb-4 px-4 text-left mt-6.25">
                                {{ bike.name }}
                            </h3>
                            <p class="text-md md:text-xl text-left px-4">
                                {{ bike.description | slice(0, 150) }}
                                ...
                            </p>
                            <p class="text-right pr-3">
                                <a href="{{ path('product_show', {slug: bike.slug, id: bike.id}) }}" class="mt-2.5 px-7.25 py-1 accentbg inline-block cursor-pointer">
                                    <img src="{{ asset('images/view.png') }}" class="h-6.75" />
                                </a>
                            </p>
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
    <section id="location" class="dark-bg text-center px-3 py-10 md:p-15">
        <img src="{{ asset('images/pin.png') }}" class="h-10 md:h-15" alt="M&S Moto Location" />
        <h3 class="mt-2.5">
            Comment nous trouver ?
        </h3>
        <h2 class="mb-11">
            Notre emplacement
        </h2>
        <div class="max-w-6xl mx-auto px-4 flex flex-col gap-6.25">
            {{ appGlobal.settings.location | raw }}
            <div class="flex items-center gap-2 md:gap-5.5">
                <img src="{{ asset('/images/location.png') }}" class="h-6 w-6 md:h-10 md:w-10" />
                <span class="text-lg md:text-3xl font-semibold text-left">
                    {{ appGlobal.settings.address }}
                </span>
            </div>
            <div class="flex items-center gap-2 md:gap-5.5">
                <img src="{{ asset('/images/phone.png') }}" class="h-6 w-6 md:h-10 md:w-10" />
                <span class="text-lg md:text-3xl font-semibold text-left">
                    {{ appGlobal.settings.phone|split('')|batch(2)|map(v => v|join(''))|join(' ') }}
                </span>
            </div>
        </div>
    </section>
    <section id="contact" class="relative accent-bg text-center px-3 py-10 md:p-15">
        <img src="{{ asset('images/plane.jpg') }}" class="absolute inset-0 w-full h-full object-cover opacity-10 pointer-events-none" alt="M&S Moto Contact BG" />
        <img src="{{ asset('images/newsletter.png') }}" class="h-15" alt="M&S Moto Contact" />
        <h3 class="mt-2.5">
            Une question ?
        </h3>
        <h2 class="mb-11">
            Contactez-Nous!
        </h2>
        <div class="max-w-3xl mx-auto px-4 flex flex-col gap-6.25">
            {{ component('ContactForm') }}
        </div>
    </section>
    {% block page_contents %}{% endblock %}
{% endblock %}
