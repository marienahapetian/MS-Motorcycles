{# templates/partials/_header.html.twig #}
<header class="site-header">
    <div class="header-overlay">
        <div class="container header-content">
            {# Logo #}
            <div class="logo">
                <a href="{{ path('homepage') }}">
                    <img src="{{ asset('images/logo_white.png') }}" alt="M&S Logo"></a>
                </div>
                {# Navigation #}
                <nav class="main-nav">
                    <ul>
                        <li>
                            <a href="{{ path('homepage') }}">
                                Accueil
                            </a>
                        </li>
                        <li>
                            <a href="{{ path('shop') }}">
                                Shop
                            </a>
                        </li>
                        <li>
                            <a href="{{ path('homepage') }}#about">
                                À propos
                            </a>
                        </li>
                        <li>
                            <a href="{{ path('homepage') }}#contact">
                                Contact
                            </a>
                        </li>
                    </ul>
                </nav>
                {# Right Icons #}
                <div class="header-icons flex items-center relative" data-controller="search-toggle" data-action="click@window->search-toggle#close">
                    <img src="{{ asset('images/search.png') }}" class="block cursor-pointer" alt="Search Icon" data-action="click->search-toggle#toggle" />
                    <div data-search-toggle-target="box" class="hidden absolute top-full right-0 mt-2">
                        <twig:SearchComponent/>
                    </div>
                    {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                        <a href="{{ path('dashboard_home') }}" class="icon user">
                            <img src="{{ asset('images/user.png') }}" class="block" alt="User Account Icon" />
                        </a>
                    {% endif %}
                </div>
            </div>
        </div>
    </header>
    