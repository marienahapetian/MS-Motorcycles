{% extends "dashboard/base.html.twig" %}
{% block content %}
    <div class="flex-1 py-10 px-10">
        <a href="{{ path('dashboard_products') }}" class="btn btn-secondary mb-2 inline-block bg-gray-400 text-white px-4 py-2 rounded-lg hover:bg-gray-500">
            ← Retour
        </a>
        <h1 class="text-3xl font-semibold mb-8">
            Modifier le produit
        </h1>
        {{ form_start(form) }}
        <div class="mb-4">
            {{ form_label(form.name, "Titre", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1' }}
            ) }}
            {{ form_widget(form.name, {'attr': {'class': 'w-full border bg-gray-100  px-3 py-2', 'placeholder': 'Titre du produit' }}
            ) }}
            <p class="text-red-500">
                {{ form_errors(form.name) }}
            </p>
        </div>
        <div class="grid md:grid-cols-4 gap-4 mb-4">
            <div>
                {{ form_label(form.price, "Prix", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1' }}
                ) }}
                {{ form_widget(form.price, {'attr': {'class': 'w-full border bg-gray-100  px-3 py-2', 'placeholder': 'Prix du produit' }}
                ) }}
                <p class="text-red-500">
                    {{ form_errors(form.price) }}
                </p>
            </div>
            <div>
                {{ form_label(form.year, "Année de sortie", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1' }}
                ) }}
                {{ form_widget(form.year, {'attr': {'class': 'w-full border bg-gray-100  px-3 py-2', min: 1910, max: 2026, 'placeholder': 'Année du produit' }}
                ) }}
                <p class="text-red-500">
                    {{ form_errors(form.year) }}
                </p>
            </div>
            <div>
                {{ form_label(form.category, "Type de Produit", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1' }}
                ) }}
                {{ form_widget(form.category, {'attr': {'class': 'w-full border bg-gray-100  px-3 py-2' }}
                ) }}
                <p class="text-red-500">
                    {{ form_errors(form.category) }}
                </p>
            </div>
            <div>
                {{ form_label(form.brand, "Marque de Produit", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1' }}
                ) }}
                {{ form_widget(form.brand, {'attr': {'class': 'w-full border bg-gray-100  px-3 py-2' }}
                ) }}
                <p class="text-red-500">
                    {{ form_errors(form.brand) }}
                </p>
            </div>
        </div>
        <div class="grid md:grid-cols-4 gap-4 mb-6">
            <div class="col-span-3 flex flex-col">
                {{ form_label(form.description, "A propos", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1' }}
                ) }}
                {{ form_widget(form.description, {'attr': {'class': 'w-full flex-1 border bg-gray-100 px-3 py-2 resize-none', 'placeholder': '' }}
                ) }}
                <p class="text-red-500">
                    {{ form_errors(form.description) }}
                </p>
            </div>
            <div>
                <p class="text-sm font-medium text-gray-700 mb-2">
                    Product Images
                </p>
                <div class="grid grid-cols-2 gap-2">
                    {% if product.mainImage %}
                        <img src="{{ product.mainImage.image }}" class="w-full col-span-2 h-40 object-cover  border" />
                    {% endif %}
                    {% if product.galleryImages %}
                        {% for image in product.galleryImages %}
                            <img src="{{ image.image }}" class="w-full h-20 object-cover  border" />
                        {% endfor %}
                    {% endif %}
                    <label class="flex items-center justify-center w-full h-20 border-2 border-dashed  cursor-pointer hover:bg-gray-50">
                        <span class="text-2xl text-gray-400">
                            +
                        </span>
                        {{ form_widget(form.images, {'attr': {'class': 'hidden','multiple': 'multiple' }}
                        ) }}
                    </label>
                    <p class="text-red-500">
                        {{ form_errors(form.images) }}
                    </p>
                </div>
            </div>
        </div>
        <div class="mb-6">
            <h2 class="text-lg font-semibold mb-2">
                Features
            </h2>
            <div class="space-y-2">
                {% for spec in product.features %}
                    <div class="grid md:grid-cols-4">
                        <label class="w-full px-2 py-1 bg-gray-100">
                            {{ spec.label }}
                        </label>
                        <input type="text" name="features[0][value]" value="{{ spec.value }}" class="w-full col-span-3 bg-teal-100 px-2 py-1" />
                    </div>
                {% endfor %}
            </div>
        </div>
        <div class="flex justify-between">
            {{ form_widget(form.save, {'attr': {'class': 'bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700' }}
            ) }}
            {{ form_widget(form.cancel, {'attr': {'class': 'bg-gray-400 text-white px-4 py-2 rounded-lg hover:bg-gray-500' }}
            ) }}
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
