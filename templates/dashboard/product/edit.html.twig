{% extends "dashboard/base.html.twig" %}
{% block content %}
    <div class="flex-1 py-10 px-10" data-controller="product-features">
        <a href="{{ path('dashboard_products') }}" class="btn btn-secondary mb-2 inline-block bg-gray-400 text-white px-4 py-2 rounded-lg hover:bg-gray-500">
            ← Retour
        </a>
        <h1 class="text-3xl font-semibold mb-8">
            Modifier le produit
        </h1>
        {{ form_start(form) }}
        {{ form_errors(form) }}
        <div class="mb-4">
            {% include 'dashboard/partials/product/_title.html.twig' %}
        </div>
        <div class="grid md:grid-cols-4 gap-4 mb-4">
            <div>
                {% include 'dashboard/partials/product/_price.html.twig' %}
            </div>
            <div>
                {% include 'dashboard/partials/product/_year.html.twig' %}
            </div>
            <div>
                {% include 'dashboard/partials/product/_categories.html.twig' %}
            </div>
            <div id="brand-container" data-product-features-target="brandContainer">
                {% include 'dashboard/partials/product/_brand.html.twig'  with {
                    form: form,
                    product: product
                } %}
            </div>
        </div>
        <div class="grid md:grid-cols-4 gap-4 mb-6">
            <div class="col-span-3 flex flex-col">
                {% include 'dashboard/partials/product/_description.html.twig' %}
            </div>
            <div data-controller="image-uploader">
                <p class="text-sm font-medium text-gray-700 mb-2">
                    Product Images
                </p>
                <div>
                    {% if product.mainImage %}
                        <img src="{{ product.mainImage.image }}" alt="Article Image" class="w-full col-span-2 h-40 object-cover  border" />
                    {% endif %}
                    <label class="flex items-center justify-center mt-2 w-full h-20 border-2 border-dashed  cursor-pointer hover:bg-gray-50">
                        <span class="text-2xl text-gray-400">
                            +
                        </span>
                        {{ form_widget(form.images, {
                            'attr': {
                                'class': 'hidden','multiple': 'multiple',
                                'data-action': 'change->image-uploader#displaySelected',
                                'data-image-uploader-target': 'input',
                                }
                            }) }}
                    </label>
                    <p class="text-red-500">
                        {{ form_errors(form.images) }}
                    </p>
                    <div id="gallery" data-image-uploader-target="galleryContainer" class="mt-2 grid grid-cols-2 gap-2">
                        {% if product.galleryImages %}
                            {% for image in product.galleryImages %}
                                <div class="relative group ">
                                    <img src="{{ asset(image.image) }}" alt="Article Image" class="w-full h-24 object-cover border" />
                                    <a href="{{ path('product_image_delete', {id: image.id}) }}" onclick="return confirm('Delete this image?')" class="absolute hidden group-hover:flex top-0 right-0 px-2 py-1 text-xs rounded">
                                        ✕
                                    </a>
                                    <a href="{{ path('product_image_main', {id: image.id}) }}" onclick="return confirm('Make this image main?')" class="absolute opacity-0 group-hover:opacity-100 transition-all duration-100 ease-in right-1/2 top-1/2 bg-white w-max translate-x-1/2 -mt-2.5 text-sm p-1">
                                        Make main image
                                    </a>
                                </div>
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
        <div id="features-container" data-product-features-target="featuresContainer">
            {% include 'dashboard/partials/product/_features.html.twig' with {
                features: availableFeatures,
                product: product
            } %}
        </div>
        <div class="flex justify-between">
            {{ form_widget(form.save, {'attr': {'class': 'bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700' }}
            ) }}
            {{ form_widget(form.cancel, {'attr': {'class': 'bg-gray-400 text-white px-4 py-2 rounded-lg hover:bg-gray-500' }}
            ) }}
        </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
