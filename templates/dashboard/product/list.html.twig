{% extends "dashboard/base.html.twig" %}
{% block content %}
    <main class="px-10 py-10 flex-1">
        <h1 class="text-3xl font-semibold mb-8">
            Toutes les articles
        </h1>
        <div class="flex justify-between items-center mb-4">
            <a href="{{ path('product_add') }}" class="bg-indigo-300 text-gray-800 px-4 py-2 rounded-md font-medium">
                + Ajouter une article
            </a>
            <input type="text" placeholder="Rechercher" class="border border-gray-400 rounded-md px-3 py-1 text-sm"></div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead class="bg-yellow-600 text-black">
                        <tr>
                            <th class="px-3 py-2">
                                #
                            </th>
                            <th class="px-3 py-2">
                                Nom
                            </th>
                            <th class="px-3 py-2">
                                Catégorie
                            </th>
                            <th class="px-3 py-2">
                                Prix
                            </th>
                            <th class="px-3 py-2">
                                Ajouté
                            </th>
                            <th class="px-3 py-2"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for product in products %}
                            <tr class="{{ loop.index is odd ? 'bg-gray-100' : 'bg-gray-200' }}">
                                <td class="px-3 py-2">
                                    {{ product.id }}
                                </td>
                                <td class="px-3 py-2">
                                    {{ product.name }}
                                </td>
                                <td class="px-3 py-2">
                                    {{ product.categories | map(c => c.name)|join(', ') }}
                                </td>
                                <td class="px-3 py-2">
                                    {{ product.price }}
                                    €
                                </td>
                                <td class="px-3 py-2">
                                    {{ product.added|date('d/m/Y') }}
                                </td>
                                <td class="px-3 py-2 space-x-2 flex">
                                    <a href="{{ path('product_edit', {id: product.id }) }}" class="text-blue-600 hover:underline">
                                        <img src="{{ asset('images/edit.png') }}" alt='Icon modifier' />
                                    </a>
                                    <form method="POST" action="{{ path('product_delete', {id:product.id}) }}">
                                        <button type="submit" href="{{ path('product_delete', {id:product.id}) }}" class="text-red-600 cursor-pointer hover:underline" onclick="return confirm('Vous etes sure?')" title="delete" class="cursor-pointer">
                                            <img src="{{ asset('images/bin.png') }}" alt='Icon supprimer' />
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% include "dashboard/partials/_pagination.html.twig" %}
        </main>
    {% endblock %}
    