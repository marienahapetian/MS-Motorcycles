{% extends "dashboard/base.html.twig" %}
{% block content %}
    <div class="flex-1 py-10 px-10">
        <a href="{{ path('dashboard_messages') }}" class="btn btn-secondary mb-2 inline-block bg-gray-400 text-white px-4 py-2 rounded-lg hover:bg-gray-500">
            ← Retour
        </a>
        <h1 class="text-3xl font-semibold mb-8">
            Détails du message
        </h1>
        <div class="card shadow-sm">
            <div class="card-body p-3">
                <div class="p-1 mb-3 grid grid-cols-4 bg-gray-100 ">
                    <span class="block col-span-1 text-sm font-medium text-gray-700 mb-1">
                        Envoyé Par:
                    </span>
                    <p class="mb-0 col-span-3">
                        {{ message.name ~ ' ' ~ message.lastname }}
                    </p>
                </div>
                <div class="p-1 mb-3 grid grid-cols-4 bg-gray-100 ">
                    <span class="block col-span-1 text-sm font-medium text-gray-700 mb-1">
                        Email:
                    </span>
                    <p class="col-span-3">
                        {{ message.sender }}
                    </p>
                </div>
                <div class="p-1 mb-3 grid grid-cols-4 bg-gray-100">
                    <span class="block col-span-1 text-sm font-medium text-gray-700 mb-1">
                        Reçue:
                    </span>
                    <p class="col-span-3">
                        {{ message.sent|date('Y-m-d H:i') }}
                    </p>
                </div>
                <div class="p-1 mb-3 grid grid-cols-4 bg-gray-100 ">
                    <span class="block text-sm font-medium text-gray-700 mb-1">
                        Sujet:
                    </span>
                    <p class="col-span-3">
                        {{ message.subject }}
                    </p>
                </div>
                <div class="p-1 mb-3">
                    <span class="block text-sm font-medium text-gray-700 mb-1">
                        Message:
                    </span>
                    <div class="bg-gray-100 px-3 py-2 ">
                        {{ message.message|nl2br }}
                    </div>
                </div>
                <div class="p-1 mb-3">
                    <a href="mailto:{{ message.sender }}" class="inline-block bg-blue-100 px-2">
                        Répondre
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
