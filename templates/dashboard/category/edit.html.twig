{% extends "dashboard/base.html.twig" %}
{% block content %}
    <div class="flex-1 py-10 px-10">
        <a href="{{ path('dashboard_categories') }}" class="btn btn-secondary mb-2 inline-block bg-gray-400 text-white px-4 py-2 rounded-lg hover:bg-gray-500">
            ← Retour
        </a>
        <h1 class="text-3xl font-semibold mb-8">
            Modifier la Catégorie
        </h1>
        {{ form_start(form) }}
        {{ form_errors(form) }}
        <div class="mb-4">
            {{ form_label(form.name, "Nom de Type de Produit", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1' }}
            ) }}
            {{ form_widget(form.name, {'attr': {'class': 'w-full border bg-gray-100  px-3 py-2', 'placeholder': 'ex Moto' }}
            ) }}
            <p class="text-red-500">
                {{ form_errors(form.name) }}
            </p>
        </div>
        <div class="mb-4">
            {% if category.icon %}
                <div class="mb-3">
                    <img src="{{ asset(category.icon) }}" alt="Thumbnail" class="w-32 h-32 object-cover rounded-lg border shadow-sm" />
                </div>
            {% endif %}
            {{ form_label(form.icon, "Image de Catégorie", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1' }}
            ) }}
            {{ form_widget(form.icon, {'attr': {'class': 'w-full border bg-gray-100 px-3 py-2 rounded-lg cursor-pointer', }}
            ) }}
            <p class="text-red-500">
                {{ form_errors(form.icon) }}
            </p>
            <p class="text-xs text-gray-500 mt-1"></p>
            Telecharger une nouvelle image pour remplacer la courrante
        </p>
    </div>
    <div class="flex justify-between">
        {{ form_widget(form.save, {'attr': {'class': 'bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700' }}
        ) }}
        {{ form_widget(form.cancel, {'attr': {'class': 'bg-gray-400 text-white px-4 py-2 rounded-lg hover:bg-gray-500' }}
        ) }}
    </div>
    {{ form_end(form) }}
</div>{% endblock %}