{% extends "dashboard/base.html.twig" %}
{% block content %}
    <main class="px-10 py-10 flex-1">
        <h1 class="text-3xl font-semibold mb-8">
            Catégories d'articles
        </h1>
        <div class="flex justify-between items-center mb-4">
            <a href="{{ path('category_add') }}" class="bg-indigo-300 text-gray-800 px-4 py-2 rounded-md font-medium">
                + Ajouter une catégorie
            </a>
            <input type="text" placeholder="Rechercher" class="border border-gray-400 rounded-md px-3 py-1 text-sm"></div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left">
                    <thead class="bg-yellow-600 text-black">
                        <tr>
                            <th class="px-3 py-2">
                                #
                            </th>
                            <th class="px-3 py-2">
                                Nom
                            </th>
                            <th class="px-3 py-2">
                                Total d'articles
                            </th>
                            <th class="px-3 py-2">
                                Ajouté
                            </th>
                            <th class="px-3 py-2"></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for category in categories %}
                            <tr class="{{ loop.index is odd ? 'bg-gray-100' : 'bg-gray-200' }}">
                                <td class="px-3 py-2">
                                    {{ category.id }}
                                </td>
                                <td class="px-3 py-2">
                                    {{ category.name }}
                                </td>
                                <td class="px-3 py-2">
                                    {{ category.products.count }}
                                </td>
                                <td class="px-3 py-2">
                                    {{ category.createdAt|date('d/m/Y') }}
                                </td>
                                <td class="px-3 py-2 space-x-2 flex">
                                    <a href="{{ path('category_edit', {id: category.id}) }}" class="text-blue-600 hover:underline">
                                        <img src="{{ asset('images/edit.png') }}" alt='Icon modifier' />
                                    </a>
                                    <form method="POST" action="{{ path('category_delete', {id:category.id}) }}">
                                        <button type="submit" href="{{ path('category_delete', {id:category.id}) }}" class="text-red-600 cursor-pointer hover:underline" onclick="return confirm('Vous etes sure?')" title="delete" class="cursor-pointer">
                                            <img src="{{ asset('images/bin.png') }}" alt='Icon supprimer' />
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% include "dashboard/partials/_pagination.html.twig" %}
        </main>
    {% endblock %}
    