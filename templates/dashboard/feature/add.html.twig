{% extends "dashboard/base.html.twig" %}
{% block content %}
    <div class="flex-1 py-10 px-10">
        <a href="{{ path('dashboard_features') }}" class="btn btn-secondary mb-2 inline-block bg-gray-400 text-white px-4 py-2 rounded-lg hover:bg-gray-500">
            ← Back to list
        </a>
        <h1 class="text-3xl font-semibold mb-8">
            Add Feature
        </h1>
        <form method="post" enctype="multipart/form-data">
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">
                    Feature Name
                </label>
                <input type="text" name="name" value="" class="w-full border bg-gray-100  px-3 py-2" />
            </div>
            <div class="mb-4">
                <label class="block text-sm font-medium text-gray-700 mb-1">
                    Applied Categories
                </label>
                <select name="categories[]" multiple class="w-full border bg-gray-100 px-3 py-2 rounded-lg">
                    {% for cat in categories %}
                        <option value="{{ cat.id }}">
                            {{ cat.name }}
                        </option>
                    {% endfor %}
                </select>
                <p class="text-xs text-gray-500 mt-1">
                    Hold Ctrl (Windows) or Cmd (Mac) to select multiple categories.
                </p>
            </div>
            <div class="flex justify-between">
                <button type="submit" class="bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700">
                    Add
                </button>
                <button type="button" class="bg-gray-400 text-white px-4 py-2 rounded-lg hover:bg-gray-500">
                    Cancel
                </button>
            </div>
        </form>
    </div>
{% endblock %}
