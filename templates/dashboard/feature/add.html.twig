{% extends "dashboard/base.html.twig" %}
{% block content %}
    <div class="flex-1 py-10 px-10" data-controller="feature-form">
        <a href="{{ path('dashboard_features') }}" class="btn btn-secondary mb-2 inline-block bg-gray-400 text-white px-4 py-2 rounded-lg hover:bg-gray-500">
            ← Retour
        </a>
        <h1 class="text-3xl font-semibold mb-8">
            Ajouter une caractéristique
        </h1>
        {{ form_start(form) }}
        <div class="mb-4">
            {{ form_label(form.name, "Nom de la caractéristique", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1' }}
            ) }}
            {{ form_widget(form.name, {'attr': {'class': 'w-full border bg-gray-100  px-3 py-2', 'value': '', 'placeholder': 'ex Couleur' }}
            ) }}
            <p class="text-red-500">
                {{ form_errors(form.name) }}
            </p>
        </div>
        <div class="mb-4">
            {{ form_label(form.name, "Type", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1' }}
            ) }}
            {% for child in form.type %}
                <div class="block mb-2">
                    {{ form_widget(child, {
                        attr: {
                            'data-action': 'change->feature-form#toggle'
                        }
                    }) }}
                    {{ form_label(child) }}
                </div>
            {% endfor %}
            <p class="text-red-500">
                {{ form_errors(form.type) }}
            </p>
        </div>
        <!-- options section -->
        <div class="mb-4 hidden" data-feature-form-target="options" data-controller="tags-input">
            {{ form_label(form.options, "Options", {
                label_attr: {
                    class: 'block text-sm font-medium text-gray-700 mb-2'
                }
            }) }}
            {# FEATURE EXISTING OPTIONS CONTAINER #}
            <div data-tags-input-target="container" class="flex flex-wrap gap-2 mb-3">
                {% for option in form.options %}
                    <div class="flex items-center gap-2 bg-gray-200 rounded-full px-3 py-1">
                        <span>
                            {{ option.vars.data.value }}
                        </span>
                        <button type="button" class="text-red-500 hover:text-red-700 font-bold" onclick="this.parentElement.remove()">
                            ✕
                        </button>
                        {{ form_widget(option.value) }}
                    </div>
                {% endfor %}
            </div>
            {# END FEATURE EXISTING OPTIONS CONTAINER #}
            <input type="text" data-tags-input-target="input" data-action="keydown->tags-input#add" class="w-full border bg-gray-100 px-3 py-2" placeholder="Ex: Rouge" />
            <div data-tags-input-target="prototype" data-prototype="{{ form_widget(form.options.vars.prototype)|e('html_attr') }}"></div>
        </div>
        <!-- end options section -->
        <div class="mb-4">
            {{ form_label(form.categories, 'Catégories de Caractéristique', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1' }}
            ) }}
            {{ form_widget(form.categories, {'attr': {'class': 'w-full border bg-gray-100 px-3 py-2 rounded-lg' }}
            ) }}
            <p class="text-xs text-gray-500 mt-1">
                Appuyez sur Ctrl (Windows) ou Cmd (Mac) pour selectioner plusieurs types.
            </p>
            {{ form_errors(form.categories) }}
        </div>
        <div class="flex justify-between">
            {{ form_widget(form.save, {'attr': {'class': 'bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700' }}
            ) }}
            {{ form_widget(form.cancel, {'attr': {'class': 'bg-gray-400 text-white px-4 py-2 rounded-lg hover:bg-gray-500' }}
            ) }}
        </div>
        {% do form.options.setRendered %}
        {{ form_end(form) }}
    </div>
{% endblock %}
