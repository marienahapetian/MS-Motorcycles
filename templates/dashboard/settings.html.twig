{% extends "dashboard/base.html.twig" %}
{% block content %}
    <div class="flex-1 py-10 px-10">
        <h1 class="text-3xl font-semibold mb-8">
            Réglages du Site
        </h1>
        {{ form_start(form) }}
        <div class="mb-4">
            {{ form_label(form.font, "Police", {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1' }}
            ) }}
            {{ form_widget(form.font, {'attr': {'class': 'w-full border bg-gray-100  px-3 py-2', 'placeholder': 'ex Arial' }}
            ) }}
            <p class="text-red-500">
                {{ form_errors(form.font) }}
            </p>
        </div>
        <div class="grid md:grid-cols-3 gap-4 mb-4">
            {% for key, label in {
                                        'accent_color': 'Couleur Accent',
                                        'black_color': 'Couleur Noir',
                                        'white_color': 'Couleur Blanc'
                            } %}
                <div>
                    {{ form_label(form[key], label, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1' }}
                    ) }}
                    {{ form_widget(form[key], {'attr': {'class': 'w-full border bg-gray-100  px-3 py-2', 'placeholder': 'ex Arial' }}
                    ) }}
                    <p class="text-red-500">
                        {{ form_errors(form[key]) }}
                    </p>
                </div>
            {% endfor %}
        </div>
        <div class="grid md:grid-cols-3 gap-4 mb-4">
            {% for key, label in {
                'instagram_link': 'Instagram Profile',
                'tweeter_link': 'Twitter Profile',
                'tiktok_link': 'TikTok Profile'
            } %}
                <div>
                    {{ form_label(form[key], label, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1' }}
                    ) }}
                    {{ form_widget(form[key], {'attr': {'class': 'w-full border bg-gray-100  px-3 py-2', 'placeholder': 'ex Arial' }}
                    ) }}
                    <p class="text-red-500">
                        {{ form_errors(form[key]) }}
                    </p>
                </div>
            {% endfor %}
        </div>
        <div class="grid md:grid-cols-2 gap-4 mb-4">
            <div>
                {{ form_label(form.phone, 'Téléphone', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1' }}
                ) }}
                {{ form_widget(form.phone, {'attr': {'class': 'w-full border bg-gray-100  px-3 py-2', 'placeholder': 'ex Arial' }}
                ) }}
                <p class="text-red-500">
                    {{ form_errors(form.phone) }}
                </p>
            </div>
            <div>
                {{ form_label(form.address, 'Address', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1' }}
                ) }}
                {{ form_widget(form.address, {'attr': {'class': 'w-full border bg-gray-100  px-3 py-2', 'placeholder': 'ex Arial' }}
                ) }}
                <p class="text-red-500">
                    {{ form_errors(form.address) }}
                </p>
            </div>
            <div class="col-span-2">
                {{ form_label(form.email, 'Email', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1' }}
                ) }}
                {{ form_widget(form.email, {'attr': {'class': 'w-full border bg-gray-100  px-3 py-2', 'placeholder': 'ex Arial' }}
                ) }}
                <p class="text-red-500">
                    {{ form_errors(form.email) }}
                </p>
            </div>
            <div>
                {{ form_label(form.location, 'Carte Google', {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1' }}
                ) }}
                {{ form_widget(form.location, {'attr': {'class': 'w-full border bg-gray-100  px-3 py-2', 'placeholder': 'ex Arial', "rows" : 10 }}
                ) }}
                <p class="text-red-500">
                    {{ form_errors(form.location) }}
                </p>
                <p class="text-xs text-gray-500 mt-1">
                    Paste your embed iframe from Google Maps
                </p>
            </div>
            {% if settings.location %}
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                        Map Preview
                    </label>
                    <div class="rounded-lg overflow-hidden border">
                        {{ settings.location|raw }}
                    </div>
                </div>
            {% endif %}
            <div class="pt-4">
                {{ form_widget(form.save, {'attr': {'class': 'bg-green-600 text-white px-4 py-2 rounded-lg hover:bg-green-700' }}
                ) }}
            </div>
            {{ form_end(form) }}
        </div>
    {% endblock %}
    