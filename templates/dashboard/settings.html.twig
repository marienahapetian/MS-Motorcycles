{% extends "dashboard/base.html.twig" %}
{% block content %}
    <div class="flex-1 py-10 px-10">
        <h1 class="text-3xl font-semibold mb-8">
            Website Settings
        </h1>
        <form method="post" class="space-y-6">
            <input type="hidden" name="_token" value="{{ csrf_token('settings') }}">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">
                        Font Family
                    </label>
                    <select name="font_family" class="w-full rounded-md border border-gray-300 focus:ring-2 focus:ring-orange-400 px-3 py-2">
                        {% set fonts = ['Hanken Grotesk', 'Inter', 'Roboto', 'Open Sans', 'Poppins'] %}
                        {% for font in fonts %}
                            <option value="{{ font }}" {{ settings.font_family == font ? 'selected' : '' }}>
                                {{ font }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <div class="grid md:grid-cols-3 gap-4">
                    {% for key, label in {
                                        'accent_color': 'Accent Color',
                                        'black_color': 'Black Color',
                                        'white_color': 'White Color'
                            } %}
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">
                                {{ label }}
                            </label>
                            <div class="flex items-center border border-gray-300 gap-2">
                                <input type="color" value="{{ attribute(settings, key) }}" onchange="this.nextElementSibling.value = this.value" class="w-12 h-10 cursor-pointer" />
                                <input type="text" name="{{ key }}" value="{{ attribute(settings, key) }}" class="flex-1 px-3 py-2 focus:ring-2 focus:ring-orange-400" />
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <div class="grid md:grid-cols-3 gap-4">
                    {% for key, label in {
                'instagram': 'Instagram Profile',
                'twitter': 'Twitter Profile',
                'tiktok': 'TikTok Profile'
            } %}
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">
                                {{ label }}
                            </label>
                            <input type="text" name="{{ key }}" value="{{ attribute(settings, key) }}" placeholder="@username" class="w-full rounded-md border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-orange-400" />
                        </div>
                    {% endfor %}
                </div>
                <div class="grid md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            Email Address
                        </label>
                        <input type="email" name="email" value="{{ settings.email }}" class="w-full rounded-md border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-orange-400"></div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">
                                Phone Number
                            </label>
                            <input type="text" name="phone" value="{{ settings.phone }}" class="w-full rounded-md border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-orange-400" />
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            Address
                        </label>
                        <input type="text" name="address" value="{{ settings.address }}" class="w-full rounded-md border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-orange-400" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">
                            Google Map Iframe
                        </label>
                        <textarea name="google_map" rows="4" class="w-full rounded-md border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-orange-400" placeholder="<iframe ...></iframe>">
                            {{ settings.google_map }}
                        </textarea>
                        <p class="text-xs text-gray-500 mt-1">
                            Paste your embed iframe from Google Maps
                        </p>
                    </div>
                    {% if settings.google_map %}
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-2">
                                Map Preview
                            </label>
                            <div class="rounded-lg overflow-hidden border">
                                {{ settings.google_map|raw }}
                            </div>
                        </div>
                    {% endif %}
                    <div class="flex justify-end pt-4">
                        <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded-lg shadow">
                            Save
                        </button>
                    </div>
                </form>
            </div>
        {% endblock %}
        