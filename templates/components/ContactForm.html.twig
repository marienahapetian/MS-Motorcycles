<div{{ attributes }}>
    {{ form_start(form, {attr: {
            'class': 'space-y-6', 
            'data-action': 'live#action:prevent',
            'data-live-action-param': 'save' }}
    ) }}
    <div class="grid md:grid-cols-2 gap-6">
        {{ form_widget(form.lastname, {
                    attr: {
                        placeholder: 'Nom',
                        class: 'text-center w-full bg-transparent border-2 border-white text-white placeholder-white px-4 py-3 outline-none focus:ring-2 focus:ring-white'
                    }
                }) }}
        {{ form_widget(form.name, {
                    attr: {
                        placeholder: 'Prénom',
                        class: 'text-center w-full bg-transparent border-2 border-white text-white placeholder-white px-4 py-3 outline-none focus:ring-2 focus:ring-white'
                    }
                }) }}
    </div>
    {{ form_widget(form.sender, {
                    attr: {
                        placeholder: 'Email',
                        class: 'text-center w-full bg-transparent border-2 border-white text-white placeholder-white px-4 py-3 outline-none focus:ring-2 focus:ring-white'
                    }
                }) }}
    {{ form_widget(form.subject, {
                    attr: {
                        placeholder: 'Sujet',
                        class: 'text-center w-full bg-transparent border-2 border-white text-white placeholder-white px-4 py-3 outline-none focus:ring-2 focus:ring-white'
                    }
                }) }}
    {{ form_widget(form.message, {
                attr: {
                    rows: 5,
                    placeholder: 'Message',
                    class: 'text-center w-full bg-transparent border-2 border-white text-white placeholder-white px-4 py-3 outline-none focus:ring-2 focus:ring-white resize-none'
                }
            }) }}
    {{ form_widget(form.submit, {
                attr: {
                    class: 'cursor-pointer w-full text-white py-4 text-lg font-semibold transition hover:opacity-80'
                }
            }) }}
    {{ form_end(form) }}
    {% if success %}
        <div class="alert alert-success font-bold p-2" data-controller="flash">
            Message envoyé !
        </div>
    {% endif %}
</div>
