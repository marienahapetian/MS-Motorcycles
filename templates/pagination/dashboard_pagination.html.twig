{% if pageCount > 1 %}
    <div class="flex gap-3 justify-center">
        {% for page in pagesInRange %}
            {% if page != current %}
                <a href="{{ path(route, query|merge({(pageParameterName): page})) }}" class="px-3 py-1">
                    {{ page }}
                </a>
            {% else %}
                <span class="page-link px-3 py-1 bg-white">
                    {{ page }}
                </span>
            {% endif %}
        {% endfor %}
    </div>
    <p class="text-gray-500 text-sm">
        Resultats
        {{ firstItemNumber }}
        à
        {{ lastItemNumber }}
        sur
        {{ totalCount }}
    </p>
{% else %}
    <p>
        Resultats
        {{ firstItemNumber }}
        à
        {{ currentItemCount }}
        sur
        {{ totalCount }}
    </p>
{% endif %}
