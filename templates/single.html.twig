{% extends "base.html.twig" %}
{% block header %}
    <section class="header">
        {% include 'partials/_header.html.twig' %}
        <div class="relative banner h-30 -mt-30">
            <img src="{{ asset('images/1907896.jpg') }}" alt="Bike" class="brightness-50 w-full h-full object-cover object-center" />
        </div>
    </section>
{% endblock %}
{% block content %}
    <div class="max-w-6xl mx-auto px-6 py-12">
        {% if is_granted('IS_AUTHENTICATED_FULLY') %}
            <div>
                <a href="{{ path('product_edit',  {id: product.id }) }}" class="mt-2.5 px-7.25 py-1 accentbg inline-block cursor-pointer text-white mb-2.5 transition-all">
                    Modifier le produit
                </a>
            </div>
        {% endif %}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
            <div data-controller="gallery">
                {# display product main image or placeholder image #}
                {% if product.mainImage %}
                    <img
                data-gallery-target="mainImage" src="{{ product.mainImage.image }}" alt="Bike" class="w-full h-60 md:h-80 object-cover mb-4" />
                    {% else %}
                    <img data-gallery-target="mainImage" src="/images/noimage.jpg" alt="Bike" class="w-full h-80 object-cover mb-4" />
                {% endif %}
                {# display product image gallery or 3 placeholder images #}
                <div class="grid grid-cols-3 gap-3">
                    {% if product.galleryImages is not empty %}
                        {% for image in product.galleryImages %}
                            <img data-gallery-target="thumbnail" data-action="click->gallery#swap" src="{{ image.image }}" alt="Thumbnail" class="w-full h-18 md:h-24 object-cover cursor-pointer hover:opacity-80 transition" />
                        {% endfor %}
                    {% else %}
                        {% for i in 1..3 %}
                            <img src="/images/noimage.jpg" alt="Thumbnail" class="w-full h-18 md:h-24 object-cover cursor-pointer hover:opacity-80 transition" />
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
            <div>
                <h1 class="text-3xl font-semibold tracking-wide">
                    {{ product.name }}
                </h1>
                <h2 class="text-md text-gray-500 font-semibold tracking-wide mb-2">
                    Harley-Davidson
                </h2>
                <div class="grid md:grid-cols-2">
                    {% if product.year %}
                        <p class="accentcolor mb-4">
                            Année:
                            {{ product.year }}
                        </p>
                    {% endif %}
                    {% if product.price %}
                        <p class="accentcolor mb-4">
                            Prix:
                            {{ product.price }}
                            €
                        </p>
                    {% endif %}
                </div>
                <p class="text-gray-500 leading-relaxed text-lg space-y-3 description">
                    {{ product.description }}
                </p>
            </div>
        </div>
        <div class="mt-16">
            <h2 class="text-xl font-semibold mb-6 tracking-wide">
                Caractéristiques techniques
            </h2>
            <div class="specs">
                {% if product.features|length > 0 %}
                    {% for spec in product.features %}
                        <div class="flex justify-between items-center px-4 py-3 sm:text-lg text-gray-600">
                            <span>
                                {{ spec.feature.name }}
                            </span>
                            <span class="text-right">
                                {{ spec.value }}
                            </span>
                        </div>
                    {% endfor %}
                {% else %}
                    <span class="text-gray-500 text-sm">
                        Aucun caractéristique disponible
                    </span>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
